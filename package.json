{
  "name": "Linktree-vue-clone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "github:eslint/js",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4",
    "wrangler": "^4.67.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.25.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1"
  }
}
